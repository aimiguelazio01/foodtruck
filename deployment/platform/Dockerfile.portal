FROM node:24-bookworm-slim AS build
WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --workspaces=false
COPY apps/portal/app ./apps/portal/app
COPY apps/portal/package.json apps/portal/tsconfig.json apps/portal/next-env.d.ts apps/portal/next.config.mjs ./apps/portal/
WORKDIR /workspace/apps/portal
RUN node ../../node_modules/next/dist/bin/next build
FROM node:24-bookworm-slim
ENV NODE_ENV=production PORT=4200 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /workspace/apps/portal/.next/standalone ./
COPY --from=build --chown=node:node /workspace/apps/portal/.next/static ./apps/portal/.next/static
USER node
EXPOSE 4200
CMD ["node","apps/portal/server.js"]
