# Copy to .env next to compose.yaml. Never commit the populated file.
# Step-by-step origin of every value: docs/SETUP_REAL.md.
# `node scripts/platform-secrets.mjs deployment/platform/.env` fills the generated values (marked [gerado]).

# --- Portal público ---
# Host and origin of the operator portal, e.g. instalar.example.pt / https://instalar.example.pt
PLATFORM_PUBLIC_HOST=
PLATFORM_ORIGIN=
# Option 2 only (docker compose --profile tunnel): connector token of the Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Segredos locais [gerado] ---
PLATFORM_DB_PASSWORD=
PLATFORM_ENCRYPTION_KEY=
PLATFORM_ADMIN_KEY=
# Ed25519 private key (64 bytes, base64url). The same key must sign the package.
PLATFORM_SIGNING_KEY=

# --- Cloudflare (conta do operador, Workers Paid) ---
PLATFORM_CLOUDFLARE_ACCOUNT=
PLATFORM_CLOUDFLARE_TOKEN=
# Operator approval to create real resources on that account.
PLATFORM_HOSTING_APPROVED=false
# Customer sites become <slug>.<domain> and <slug>-gestao.<domain>. The domain must be a Cloudflare zone
# on PLATFORM_CLOUDFLARE_ACCOUNT.
PLATFORM_SITE_DOMAIN=
PLATFORM_SITE_ZONE_ID=
# Absolute folder of the signed package (output/cloudflare/<version>).
PLATFORM_PACKAGE_HOST_PATH=

# --- Email (Brevo) ---
# The sender domain must be authenticated in Brevo (DKIM + DMARC on the Cloudflare DNS).
PLATFORM_BREVO_API_KEY=
PLATFORM_MAIL_FROM=

# --- Pagamentos (Stripe; test keys first) ---
# The webhook endpoint is PLATFORM_ORIGIN/stripe/webhook with the events
# checkout.session.completed, invoice.paid, invoice.payment_failed, customer.subscription.updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Ciclo de vida ---
# Free trial length for self-service signups (1-365, default 14).
PLATFORM_TRIAL_DAYS=14
# Suspended sites keep their data this many days (default 30), then are backed up and removed.
PLATFORM_RETENTION_DAYS=30
# Removal deletes Workers, database and images. Leave off until a restore from backup has been tested.
PLATFORM_TEARDOWN_APPROVED=false
# Optional cap on managed installations (0 = unlimited). Set from your Cloudflare account limits.
PLATFORM_MAX_INSTALLATIONS=0

# --- Conta Cloudflare do cliente (modo avançado; deixar vazio) ---
PLATFORM_OAUTH_CLIENT_ID=
PLATFORM_OAUTH_CLIENT_SECRET=
# Use the exact scope IDs registered on the Cloudflare OAuth client.
PLATFORM_OAUTH_SCOPES=

# --- Demonstração partilhada (opcional) ---
# Escritos por `go -C desktop/launcher run ./cmd/platform -demo-install -env ../../deployment/platform/.env`
# (a partir da raiz do projeto, com o Node instalado). Com os dois preenchidos, o painel mostra "Experimentar a demonstração".
PLATFORM_DEMO_CUSTOMER_URL=
PLATFORM_DEMO_MANAGEMENT_URL=
