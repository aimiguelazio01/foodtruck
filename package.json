{
  "name": "food-truck-live",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-network.mjs",
    "build": "npm run build --workspaces --if-present",
    "start": "node scripts/dev-network.mjs --production",
    "test": "npm run test:distribution",
    "setup": "node scripts/launch.mjs --system",
    "seed": "node scripts/seed-network.mjs",
    "worker": "npm run worker --workspace=@foodtruck/api",
    "backup": "node scripts/backup-network.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "typecheck": "npm run typecheck --workspace=@foodtruck/api",
    "install:init": "node scripts/install.mjs init",
    "install:check": "node scripts/install.mjs check",
    "install:doctor": "node scripts/install.mjs doctor",
    "db:migrate": "node scripts/install.mjs migrate",
    "db:bootstrap": "node scripts/bootstrap-network.mjs",
    "package:release": "python scripts/package-release.py",
    "manuals:build": "python scripts/build-manuals.py",
    "cloudflare:prepare": "node scripts/prepare-cloudflare.mjs",
    "build:install": "node scripts/install.mjs build",
    "launch": "node scripts/launch.mjs",
    "demo": "node scripts/launch.mjs --demo",
    "install:token": "node scripts/create-install-token.mjs",
    "test:distribution": "node node_modules/tsx/dist/cli.mjs services/api/scripts/test-distribution.ts",
    "test:release": "python scripts/test-release.py",
    "test:launcher": "node scripts/test-launcher.mjs",
    "test:marketplace": "node --test scripts/test-marketplace.mjs",
    "test:marketplace:launch": "node scripts/test-marketplace-launch.mjs",
    "desktop:prepare": "npm run build && node node_modules/typescript/bin/tsc -p desktop/tsconfig.json && node desktop/setup-tools.mjs && node desktop/prepare.mjs",
    "desktop:package": "python desktop/package-native.py windows-x64 && python desktop/package-native.py macos-arm64 && python desktop/package-native.py macos-x64 && python desktop/package-native.py linux-x64 && python desktop/package-native.py linux-arm64",
    "test:desktop": "go -C desktop/launcher test ./... && python desktop/validate-installers.py",
    "test:desktop:windows": "node desktop/test-native.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@opennextjs/cloudflare": "1.20.15",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "5.9.3",
    "wrangler": "4.157.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ]
}
