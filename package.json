{
  "name": "food-truck-live",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-network.mjs",
    "build": "npm run build --workspaces --if-present",
    "start": "node scripts/dev-network.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs",
    "backup": "node scripts/backup-network.mjs",
    "test:e2e": "playwright test",
    "dev:legacy": "next dev",
    "build:legacy": "next build",
    "start:legacy": "node scripts/start.mjs",
    "db:local": "node scripts/local-postgres.mjs",
    "test:api": "node --env-file-if-exists=data/network.env node_modules/tsx/dist/cli.mjs services/api/scripts/test-checkout.ts && node --env-file-if-exists=data/network.env node_modules/tsx/dist/cli.mjs services/api/scripts/test-customer.ts",
    "typecheck": "npm run typecheck --workspace=@foodtruck/api",
    "backup:legacy": "node --env-file-if-exists=.env.local scripts/backup.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "embedded-postgres": "18.6.0-beta.19"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ]
}
