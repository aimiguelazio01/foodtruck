DATABASE_PATH=data/foodtruck.sqlite
APP_URL=http://localhost:3000
DEMO_MODE=1
# Set a licensed tile provider URL for production traffic.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional Google Maps browser integration; leave empty for OpenStreetMap + Photon.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Photon-compatible geocoding endpoint (can point to a hosted/private instance).
GEOCODING_BASE_URL=https://photon.komoot.io/
