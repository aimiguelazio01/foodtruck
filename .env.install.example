# Food Truck Live - copiar com npm run install:init e editar .env.install
DATABASE_URL=postgresql://foodtruck:ALTERAR@localhost:5432/foodtruck
# Ligação direta ou session pooler para migrações; nunca transaction pooler.
DATABASE_MIGRATION_URL=
# Certificado oficial do fornecedor; não desativar validação TLS.
DATABASE_CA_CERT_FILE=
CUSTOMER_APP_URL=http://localhost:3000
MANAGEMENT_APP_URL=http://localhost:3001
INTERNAL_API_URL=http://127.0.0.1:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
HOST=0.0.0.0
PORT=4000
DATA_DIRECTORY=./data
DEMO_MODE=0
# stream para ligação direta/session; poll para servidor sem streams ou transaction pooler.
API_UPDATES_MODE=poll
# Brevo ou SMTP; variáveis só no servidor da API.
BREVO_API_KEY=
MAIL_FROM=
SMTP_URL=
# Imagens: disco persistente OU Supabase privado OU S3/R2.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=foodtruck-media
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Docker Compose (apenas instalação com base local).
POSTGRES_PASSWORD=ALTERAR
CUSTOMER_DOMAIN=food.example.com
MANAGEMENT_DOMAIN=manage.example.com

# Cópia apenas do esquema desta aplicação (Supabase).
# BACKUP_SCHEMA=foodtruck
