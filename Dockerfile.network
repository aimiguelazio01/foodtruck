FROM node:24-bookworm-slim AS build
WORKDIR /workspace
COPY . .
RUN npm ci --no-audit --no-fund
ENV NEXT_TELEMETRY_DISABLED=1 INTERNAL_API_URL=http://api:4000
RUN npm run build
FROM node:24-bookworm-slim AS runtime
WORKDIR /workspace
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 INTERNAL_API_URL=http://api:4000 DATA_DIRECTORY=/workspace/data
COPY --from=build --chown=node:node /workspace /workspace
RUN mkdir -p /workspace/data && chown node:node /workspace/data
USER node
CMD ["node","scripts/container-network.mjs"]
