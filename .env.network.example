# Copy to .env.network; never commit production secrets.
CUSTOMER_APP_URL=https://food.example.com
MANAGEMENT_APP_URL=https://manage.example.com
CUSTOMER_DOMAIN=food.example.com
MANAGEMENT_DOMAIN=manage.example.com
INTERNAL_API_URL=http://api:4000
POSTGRES_PASSWORD=replace-with-long-random-secret
DEMO_MODE=0
CORS_ORIGINS=https://food.example.com,https://manage.example.com
# SMTP_URL=smtp://user:password@mail.example.com:587
# MAIL_FROM=Food Truck Live <orders@example.com>
# Free transactional email via Brevo (alternative to SMTP_URL):
# BREVO_API_KEY=configure-only-in-server-secrets
# MAIL_FROM=Food Truck Live <verified-sender@example.com>
# S3_BUCKET=foodtruck-media
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: organization whose identity is used for this installation.
# With exactly one organization, it is selected automatically.
PUBLIC_ORGANIZATION_ID=
