{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Food Truck Live Cloud",
  "version": "0.1.0",
  "identifier": "studio.mvirgil.foodtruck.cloud",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Food Truck Live · Cloudflare", "width": 1000, "height": 760, "minWidth": 760, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "targets": ["nsis", "dmg", "appimage"],
    "externalBin": ["binaries/foodtruck-cloud-engine"],
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" } }
  }
}
